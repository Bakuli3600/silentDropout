# Silent Dropout Detection System - environment configuration example.
# Copy to .env and edit:  cp .env.example .env

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=0

# CORS (Frontend origin if the dashboard is served separately)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin / retraining protection
# Set a strong random value in production.  Keys are compared as exact strings.
API_ADMIN_KEY=change-me

# Model training / inference
# CPU threads to use for LightGBM (use for resource-constrained machines).
LGBM_N_JOBS=4
# If set to a non-empty value, the training CLI will subsample the dataset and
# record the sample size + method in the processed metadata.
DATASET_SAMPLE_LIMIT=
DATASET_SAMPLE_METHOD=random

# Paths (typically only change if you restructure the project)
DATA_DIR=data
MODEL_DIR=backend/models

# Logging
LOG_LEVEL=INFO
